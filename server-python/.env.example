# TIDAL Playlist Merger - Environment Configuration
# Copy this file to .env and adjust values if needed.

# URL of the frontend client (for CORS matching)
CLIENT_URL=http://localhost:5173

# Additional allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port the FastAPI server will listen on
PORT=8000

# File where the Tidal authenticated session is stored (do not commit this file!)
TOKEN_FILE=tidal_session.json

# Default country code
TIDAL_COUNTRY_CODE=US
